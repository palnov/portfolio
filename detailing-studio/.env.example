# Настройки окружения для Premium Detailing Studio

# 1. Интеграция с Telegram
# Токен бота можно получить у @BotFather в Telegram
TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN_HERE"
# ID канала, чата или вашего личного аккаунта (можно получить у @userinfobot)
TELEGRAM_CHAT_ID="YOUR_CHAT_ID_HERE"

# 2. Интеграция с Яндекс.Диском (CRM)
# OAuth токен Яндекса. Получить его можно, зарегистрировав приложение на https://oauth.yandex.ru/
# с правами на доступ к Яндекс.Диску (чтение и запись в созданную папку или весь Диск)
YANDEX_OAUTH_TOKEN="YOUR_YANDEX_OAUTH_TOKEN_HERE"
# Путь к файлу CRM на Яндекс.Диске, куда будут добавляться лиды
YANDEX_CRM_FILE_PATH="app:/detailing_crm.csv"

# 3. Интеграция с Яндекс.Таблицами (CMS)
# Ссылка на опубликованную в веб Яндекс.Таблицу в формате CSV.
# Чтобы получить ее: Откройте таблицу -> Файл -> Поделиться -> Опубликовать в интернете -> Выберите CSV -> Скопируйте ссылку
YANDEX_CMS_SHEET_URL=""
